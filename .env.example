# Copy this file to .env.local (same folder) and fill in the two values. .env.local is never committed.
# Where to find them: docs/database.md, "Create the database".
# This is the ADMIN token, for your own computer only. The live site uses a separate READ-ONLY token that is set in Netlify, not here.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=paste-the-token-here

# For practice with no account at all, comment out the two lines above and use this one instead:
# CURIOHATCH_DB=file:content/dev.db

# To switch the database off and use the JSON files again, uncomment this (it overrides the lines above):
# CURIOHATCH_STORE=json
